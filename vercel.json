{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/chat", "dest": "/server.js" },
    { "src": "/api/upload", "dest": "/server.js" },
    { "src": "/(.*\\.(css|js|html|ico|png|jpg|webp|svg|woff2?))", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
